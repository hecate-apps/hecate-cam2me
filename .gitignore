# Rust -- Cargo.lock IS committed for rust/cam2me-ffi/ (application
# crate: pin what was built and tested, the opposite of macula-rust's
# and macula-rust-ffi's own "don't commit the lock" policy for
# themselves as libraries).
/rust/cam2me-ffi/target/
Cargo.lock.bak

# Android -- generated by scripts/build-rust-android.sh and Gradle itself.
# Scoped to exactly the generated UniFFI bindings path, not the whole io/
# tree -- the app's own source lives under io/macula/cam2me/ now too.
/android/app/src/main/jniLibs/
/android/app/src/main/kotlin/io/macula/sdk/
/android/.gradle/
/android/build/
/android/app/build/
/android/local.properties
/android/gradlew
/android/gradlew.bat
/android/gradle/wrapper/gradle-wrapper.jar

# iOS -- generated by scripts/build-rust-ios.sh and XcodeGen. The
# .xcodeproj itself is regenerated from ios/project.yml via `xcodegen
# generate`, never hand-edited or committed.
/ios/MaculaCam2Me/ffi/
/ios/MaculaRustFFI.xcframework/
/ios/MaculaCam2Me.xcodeproj/
/ios/DerivedData/

# OS cruft
.DS_Store
